# temporary test setup — copy to mysql_root.env (NOT committed):
#   cp secrets/mysql_root.env.example secrets/mysql_root.env
#   chmod 600 secrets/mysql_root.env
# Generate: openssl rand -base64 32
#
# Security scheme:
# - Root password lives ONLY in this file (not in .env with the app).
# - MYSQL_ROOT_HOST=localhost so root cannot log in from other containers/network.
# - Day-to-day app access uses newapi via .env only.

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
