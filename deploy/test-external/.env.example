# temporary test setup — copy to .env and replace CHANGE_ME before start:
#   cp .env.example .env
#   chmod 600 .env
#
# App / MySQL app-user secrets only. MySQL root is NOT here — see secrets/mysql_root.env.example
#
# SESSION_SECRET / CRYPTO_SECRET / SESSION_COOKIE_SECURE are set in docker-compose.yml
# for this temporary HTTP (:8080) test stack (two independent fixed secrets; Secure=false).

MYSQL_USER=newapi
MYSQL_PASSWORD=CHANGE_ME

# Optional
TZ=Asia/Shanghai
# Docker bridge / private ranges trusted as reverse proxies (Caddy)
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
