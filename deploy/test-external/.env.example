# temporary test setup — copy to .env and replace every CHANGE_ME before start:
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit real .env. Generate secrets on the server only:
#   openssl rand -hex 32
# SESSION_SECRET and CRYPTO_SECRET MUST be two different values.

MYSQL_USER=newapi
MYSQL_PASSWORD=CHANGE_ME

# Required: two independent random secrets (do NOT reuse the leaked compose values)
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
CRYPTO_SECRET=CHANGE_ME_different_openssl_rand_hex_32

# HTTPS console (self-signed on IP). Exact Origin, no path/wildcard.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://159.75.3.202

# Optional
TZ=Asia/Shanghai
# Docker bridge / private ranges trusted as reverse proxies (Caddy)
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
