# temporary test setup — copy to .env and replace every CHANGE_ME before start:
#   cp .env.example .env

# MySQL application user (used by new-api via SQL_DSN) — NOT root
MYSQL_USER=newapi
MYSQL_PASSWORD=CHANGE_ME

# MySQL root password (container init / emergency admin only; app does not use this)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_ONLY

# Session / crypto secret — generate a fixed random string, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_REPLACE_WITH_openssl_rand_hex_32

# HTTPS console (access via https://newapi.aigava.ai:8443)
SESSION_COOKIE_SECURE=true
# Exact public HTTPS Origin (scheme + host + port). No path / wildcard.
SESSION_COOKIE_TRUSTED_URL=https://newapi.aigava.ai:8443

# Optional
TZ=Asia/Shanghai
# Docker bridge / private ranges trusted as reverse proxies (Caddy)
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
